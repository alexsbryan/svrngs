{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" }
      ]
    },
    {
      "source": "/sign.html",
      "headers": [
        { "value": "frame-ancestors https:", "key": "Content-Security-Policy" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/lend.js",
      "headers": [
        { "key": "content-security-policy", "value": "default-src 'none'; connect-src 'self' wss: https:; script-src 'self' 'wasm-unsafe-eval'" }
      ]
    },
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/(index.html|open.html|sw.js|404.html)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
