  {
    "name": "before any act, nothing is kept and no computer can keep",
    "ops": [],
    "kept": { "apps": {}, "can_keep": {}, "refused": [] }
  },
  {
    "name": "a computer that said it can keep starts an app, and keeps it",
    "ops": [
      { "id": "r1", "actor": "a1", "person": "cy", "person_key": "ka", "ts_unix": 1, "voided": false, "payload": { "kind": "ready" } },
