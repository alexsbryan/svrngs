{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory": {
      "~/dev/svrn-docs/**": "allow",
      "~/dev/commonwealth-ai/**": "allow",
      "~/.svrnmesh/**": "allow",
      "~/.cargo/registry/src/**": "allow",
      "/tmp/**": "allow",
      "/private/tmp/**": "allow",
      "/run/**": "allow",
      "~/dev/*": "allow",
      "~/.cache/llama.cpp/*": "allow",
      "~/.npm/*": "allow",
      "~/.rustup/toolchains/*": "allow",
      "~/.config/*": "deny",
      "~/.ssh/*": "deny",
      "~/.gnupg/*": "deny",
      "~/.local/share/*": "deny",
      "~/.cache/huggingface/*": "deny",
      "~/dev/*/.env*": "deny"
    },
    "edit": {
      "*": "allow",
      "../*": "deny",
      "../../../../tmp/*": "allow",
      ".opencode/*": "deny",
      "ralph/claude-settings.json": "deny",
      ".githooks/*": "deny"
    },
    "bash": {
      "*": "allow",
      "git push*": "deny",
      "git reset --hard*": "deny",
      "git rebase*": "deny",
      "git commit --amend*": "deny",
      "git filter-*": "deny",
      "* --no-verify*": "deny",
      "sudo *": "deny",
      "rm -rf /": "deny",
      "rm -rf /*": "deny",
      "rm -rf ~": "deny",
      "rm -rf ~/*": "deny",
      "rm -rf $HOME*": "deny",
      "git add -A*": "deny",
      "git add --all*": "deny",
      "git add -u*": "deny",
      "git add .": "deny",
      "git add . *": "deny",
      "git add :/*": "deny",
      "git commit -a*": "deny",
      "git commit --all*": "deny",
      "docker*": "deny",
      "* docker *": "deny",
      "orb*": "deny",
      "*opencode.json*": "deny",
      "*claude-settings.json*": "deny",
      "*.githooks*": "deny",
      "*core.hooksPath*": "deny",
      "*hooksPath*": "deny"
    },
    "webfetch": "deny",
    "websearch": "deny",
    "task": "deny",
    "question": "deny"
  }
}
