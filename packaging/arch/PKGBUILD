# svrngs, and Give beside it, as pacman packages from svrngs's signed
# GitHub Release: the bytes the group page's get/ serves
# (scripts/build-release.sh). makepkg refuses a tarball unless its .sig is
# by the release key (RELEASES.md, "Signed releases") and its sum is the
# release's SHA256SUMS line. The binaries are static (musl) and kept as
# released, so nothing is linked and nothing is stripped. README.md says how
# to build, install and remove them.
#
# Two packages, as install.sh gets Give only when asked (--give): Give is a
# program of its own that links no svrngs crate (apps/give/Cargo.toml), and
# only it needs Podman. They share this pkgver, so Give's version here is
# the svrngs release that carries it.
pkgbase=svrngs-bin
pkgname=(svrngs-bin svrngs-give-bin)
pkgver=1.13.3
pkgrel=1
pkgdesc="Keep what your group shares on your own computers"
arch=('x86_64' 'aarch64')
url="https://github.com/alexsbryan/svrngs"
license=('AGPL-3.0-or-later')
options=('!strip' '!debug')
validpgpkeys=('46B4D67C5E6621093BB1AB2B057BF9082AA03CFB') # the svrngs release key
_get="$url/releases/download/v$pkgver"
source=(updated-by svrngs.service svrngs.desktop give.service svrngs.svg svrngs.sleep)
source_x86_64=("svrngs-$pkgver-linux-x86_64.tar.gz::$_get/svrngs-linux-x86_64.tar.gz"
               "svrngs-$pkgver-linux-x86_64.tar.gz.sig::$_get/svrngs-linux-x86_64.tar.gz.sig"
               "give-$pkgver-linux-x86_64.tar.gz::$_get/give-linux-x86_64.tar.gz"
               "give-$pkgver-linux-x86_64.tar.gz.sig::$_get/give-linux-x86_64.tar.gz.sig")
source_aarch64=("svrngs-$pkgver-linux-aarch64.tar.gz::$_get/svrngs-linux-aarch64.tar.gz"
                "svrngs-$pkgver-linux-aarch64.tar.gz.sig::$_get/svrngs-linux-aarch64.tar.gz.sig"
                "give-$pkgver-linux-aarch64.tar.gz::$_get/give-linux-aarch64.tar.gz"
                "give-$pkgver-linux-aarch64.tar.gz.sig::$_get/give-linux-aarch64.tar.gz.sig")
sha256sums=('156550c74ba7b2f43db0ffc4774f02919a9cd5583de4f83982dda870cbfe742c'
            'ba3cfc72b741341a849434e0c86be29d73a4c40e6d9574dfc09696b8649b3b4d'
            'd5a74c9218a57af83ed52a922b7b664ed43dce9f1bcd1f87c91e5589f027144e'
            '6da9f803e0968bd48b8292f70718cfe07ce0553e26c0f2682519f3447ff3dc4c'
            '167affad6218b4d1cf3aa15c3c9a427f474e0e71795a6f8d8ecc3f6e7e98c603'
            '1ec5889f759fe1e41f47379a7765346f9e37b60c2f15452ff69fe63911150f9c')
# Each tarball's sum is its line in the release's SHA256SUMS; each .sig's is
# the sum of that asset as the release serves it, so none is SKIP.
sha256sums_x86_64=('5f85f0176c1c4c384d396c2514e4938371f1dc549ec6f5f86050afad6cca5d2e'
                   '6de81c5f1ba650a78c701b4ce258b9e58b21722a5e9121b4624235e7514ed84f'
                   'd0867f7fb9f7767a8e2509d8398917e07e7613a8ff691cac721940bddc28c5c5'
                   '1ed2a9ef759a1dd3a3345cc6b4eb85785f17c37381874fd5b5df6848741dccfb')
sha256sums_aarch64=('9e812dc019a51a39fdece659202f7b99775005078e67dbb5837bd069aa005937'
                    '3a1e8d7b4a9d094500cc34657128b2f4fd9aab788c48c537d7c01c6e01e69b56'
                    'e1d75f74f46cd40e36d61fb0bd94b193d48b0dccb25a930d237b0632749de183'
                    'b3876fb264fa57daa2901e4443994845b9842581ea8dcb4ab24ec9e5a5e3501a')

package_svrngs-bin() {
  provides=('svrngs')
  conflicts=('svrngs')
  install=svrngs-bin.install
  install -Dm755 svrngs "$pkgdir/usr/bin/svrngs"
  # svrngs reads this beside itself, /usr/bin/../lib/svrngs/updated-by, and
  # then never replaces itself: `svrngs update` says its first line
  # (crates/svrngs-node/src/update.rs, UPDATED_BY and packaged).
  install -Dm644 updated-by "$pkgdir/usr/lib/svrngs/updated-by"
  # What install.sh writes in a person's home, here for every person:
  # svrngs kept running at login, and the opener in the applications menu.
  install -Dm644 svrngs.service "$pkgdir/usr/lib/systemd/user/svrngs.service"
  install -Dm644 svrngs.desktop "$pkgdir/usr/share/applications/svrngs.desktop"
  # The menu entry's icon (Icon=svrngs): the app icon, which
  # docs/brand/src/build.mjs writes here beside docs/brand/icon.svg.
  install -Dm644 svrngs.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/svrngs.svg"
  # Before the computer sleeps, each person's svrngs pushes the app writes no
  # other computer holds yet to one that's awake: the platform's hook, the
  # only part of that push that knows how Linux sleeps (svrngs.sleep).
  install -Dm755 svrngs.sleep "$pkgdir/usr/lib/systemd/system-sleep/svrngs"
}

package_svrngs-give-bin() {
  pkgdesc="Give: your group keeps an app on one member's computer at a time, in rootless Podman"
  depends=('svrngs' 'podman')
  install=svrngs-give-bin.install
  install -Dm755 give "$pkgdir/usr/bin/give"
  install -Dm644 give.service "$pkgdir/usr/lib/systemd/user/give.service"
}
