#!/bin/sh
# Before the computer sleeps, systemd runs each file in
# /usr/lib/systemd/system-sleep/ as root, with "pre" (systemd-sleep(8)), and
# waits for it. Each person whose svrngs runs here asks it, as them, to push
# the app writes no other computer holds yet to one that's awake (svrngs's
# POST /v1/sleeps), so a closing lid strands none. An ask still unanswered
# after 10 seconds is let go, and the computer sleeps.
[ "$1" = pre ] || exit 0
for uid in $(ps -o uid= -p "$(pgrep -d, -x svrngs)" 2>/dev/null | sort -u); do
  entry=$(getent passwd "$uid") || continue
  user=${entry%%:*}
  home=$(echo "$entry" | cut -d: -f6)
  timeout 10 runuser -u "$user" -- env HOME="$home" /usr/bin/svrngs ask /v1/sleeps '{}' >/dev/null 2>&1 || :
done
exit 0
