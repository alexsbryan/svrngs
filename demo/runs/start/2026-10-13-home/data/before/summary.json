{
 "bo_join": {
  "exit": 0,
  "said": "You're in Lab, as Bo.\nLab's folder is /tmp/sh-w/bo/svrngs/Lab: what anyone in Lab puts there reaches this computer, and what you put there reaches theirs."
 },
 "shares": {
  "llama-server": {
   "exit": 0,
   "said": "Lent llama-server (port 18089) to everyone in your groups, up to 4 people at once.\nThey cannot open /slots, /v1/stream, /v1/streams, /v1/chat/completions/control, /lora-adapters, /metrics, /tools, /cors-proxy, /models: svrngs keeps these back whenever a llama-server is lent, since they show one person's use of it to the others or change it for everyone.\nsvrngs is running here already, so they can open it now.\n`svrngs unshare llama-server` stops lending it.\nIf llama-server takes a password on each request, paste what it takes in its Authorization header, then press Enter (Enter alone for none):"
  },
  "night": {
   "exit": 0,
   "said": "Lent night (port 18091) to everyone in your groups, as many at once as want it. To let fewer in at once, change it on your home page, or `svrngs share 18091 --limit <number>`.\nsvrngs is running here already, so they can open it now.\n`svrngs unshare night` stops lending it.\nIf night takes a password on each request, paste what it takes in its Authorization header, then press Enter (Enter alone for none):"
  },
  "taste": {
   "exit": 0,
   "said": "Lent taste (port 18092) to everyone in your groups, as many at once as want it. To let fewer in at once, change it on your home page, or `svrngs share 18092 --limit <number>`.\nAn app uses it only once the person it acts for says yes to: \"the films you have marked\".\nsvrngs is running here already, so they can open it now.\n`svrngs unshare taste` stops lending it.\nIf taste takes a password on each request, paste what it takes in its Authorization header, then press Enter (Enter alone for none):"
  }
 },
