+/// **What a member holds of a hash is told only as a get of it would be
+/// served** (part B's authority): Ana's file in `films` is held by her; Ben,
+/// in `films`, is told her bitfield, and Cy, who stands with her only in
+/// `house`, is refused. Red with the provider's observe arm answering
+/// without `serves`: Cy learns what Ana holds of a hash no group of theirs
+/// places.
+#[tokio::test]
+async fn a_bitfield_is_told_only_as_a_get_would_be_served() {
+    let group = Group::computers().await;
+    let films = found("films", 9, &group.ana, &[(&group.ben, 2)]);
+    found("house", 7, &group.ana, &[(&group.cy, 3)]);
+    group.settle().await;
+    let root = tempfile::tempdir().unwrap();
+    let ana = synced_in(&group.ana, root.path(), &films).await;
+    let bytes = noise(30_000, b"bits");
+    std::fs::write(ana.join("f.bin"), &bytes).unwrap();
+    let hash = iroh_blobs::Hash::from_bytes(*blake3::hash(&bytes).as_bytes());
+    let asked = tempfile::tempdir().unwrap();
+    let t0 = std::time::Instant::now();
+    let told = loop {
+        let told = asked_bits(&group.ben, &group.ana, hash, &asked.path().join("ben")).await;
+        if told == Ok((30_000, true)) || t0.elapsed() > Duration::from_secs(15) {
+            break told;
+        }
+        tokio::time::sleep(Duration::from_millis(200)).await;
+    };
+    assert_eq!(
+        told,
+        Ok((30_000, true)),
+        "Ana tells Ben, in films, what she holds"
+    );
+    let cy = asked_bits(&group.cy, &group.ana, hash, &asked.path().join("cy")).await;
+    assert!(
+        cy.is_err(),
+        "Ana refuses Cy, in no group placing it: {cy:?}"
+    );
+    group.close().await;
+}
