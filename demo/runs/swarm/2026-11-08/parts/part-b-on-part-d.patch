+/// **A file past one slice arrives whole at two members** (part B): 9 MiB,
+/// three slices of 4 MiB. Red with a slice's request cut short of its end.
+#[tokio::test]
+async fn a_file_past_one_slice_arrives_whole_at_two_members() {
+    let group = Group::new().await;
+    let roots: Vec<_> = (0..3).map(|_| tempfile::tempdir().unwrap()).collect();
+    let (ana, ben, cy) = (
+        both_ways(&group.ana, roots[0].path()).await,
+        both_ways(&group.ben, roots[1].path()).await,
+        both_ways(&group.cy, roots[2].path()).await,
+    );
+    let bytes = noise(9 << 20, b"sliced");
+    std::fs::write(ana.join("big.bin"), &bytes).unwrap();
+    let at = |d: &Path| std::fs::read(d.join("big.bin")).ok().as_ref() == Some(&bytes);
+    assert!(
+        until(&group, || at(&ben) && at(&cy)).await,
+        "the whole file reaches Ben and Cy"
+    );
+    group.close().await;
+}
