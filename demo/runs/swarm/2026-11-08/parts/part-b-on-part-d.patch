+/// `from` asks `holder` what it holds of `hash`: the first bitfield's
+/// `(size, whether complete)`, or why none came.
+async fn asked_bits(
+    from: &Node,
+    holder: &Node,
+    hash: iroh_blobs::Hash,
+    dir: &Path,
+) -> Result<(u64, bool), String> {
+    use n0_future::StreamExt as _;
+    let store = iroh_blobs::store::fs::FsStore::load(dir).await.unwrap();
+    let conn = from
+        .endpoint()
+        .connect(holder.endpoint().id(), b"/iroh-bytes/4")
+        .await;
+    let conn = conn.map_err(|e| format!("the dial: {e}"))?;
+    let asked = iroh_blobs::protocol::ObserveRequest::new(hash);
+    let mut seen = std::pin::pin!(store.remote().observe(conn, asked));
+    match tokio::time::timeout(Duration::from_secs(10), seen.next()).await {
+        Ok(Some(Ok(bits))) => Ok((bits.size(), bits.is_complete())),
+        Ok(Some(Err(e))) => Err(format!("{e}")),
+        Ok(None) => Err("no bitfield".into()),
+        Err(_) => Err("no answer".into()),
+    }
+}
