+///
+/// Found ended at an ask, the server is said so and started again, so its
+/// crash costs the tests that were driving it then, which fail on their
+/// lost connection, and never every test after them: Playwright 1.59.1's
+/// server died on its own assertion and 33 of a step's 45 rows failed with
+/// it (demo/runs/flakes/2026-11-19/).
+pub fn browsers() -> String {
+    static SHARED: Mutex<Option<(std::process::Child, String)>> = Mutex::new(None);
+    let mut shared = SHARED.lock().unwrap_or_else(|p| p.into_inner());
+    if let Some((run, _)) = shared.as_mut() {
+        match run.try_wait() {
+            Ok(None) => {}
+            ended => {
+                eprintln!("harness: web/tests/browsers.mjs ended ({ended:?}): the tests driving its browsers then fail, and it is started again for the tests after them");
+                *shared = None;
+            }
+        }
+    }
+    shared.get_or_insert_with(started).1.clone()
+}
+
+/// web/tests/browsers.mjs started, and the addresses it printed.
+fn started() -> (std::process::Child, String) {
+    let mut run = std::process::Command::new("node")
+        .arg(repo().join("web/tests/browsers.mjs"))
+        .stdin(std::process::Stdio::piped())
+        .stdout(std::process::Stdio::piped())
+        .spawn()
+        .expect("node runs web/tests/browsers.mjs");
+    let mut line = String::new();
+    let out = std::io::BufReader::new(run.stdout.take().unwrap());
+    std::io::BufRead::read_line(&mut { out }, &mut line).expect("browsers.mjs answers");
+    assert!(
+        line.starts_with('{'),
+        "web/tests/browsers.mjs did not start Chromium and WebKit, so no page can be tested: {line:?}; install them with: npm ci --prefix web && npx --prefix web playwright install chromium webkit"
+    );
+    (run, line.trim().to_string())
 }
 
