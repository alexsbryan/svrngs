+/// svrngs phone spike (svrngs demo/runs/phone-replica/2026-10-27/PREDICTIONS.md, "The ladder"):
+/// how net reports run, from `SVRNGS_IROH_REPORTS`, read once. Unset or "stock": iroh's own.
+/// "periodic": every 5 minutes, none on a link change. "relay": one at start, none after.
+fn svrngs_reports() -> &'static str {
+    static MODE: std::sync::OnceLock<String> = std::sync::OnceLock::new();
+    MODE.get_or_init(|| {
+        let mode = std::env::var("SVRNGS_IROH_REPORTS").unwrap_or_else(|_| "stock".into());
+        debug!(mode, "svrngs: net report mode");
+        mode
+    })
+}
