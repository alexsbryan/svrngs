.....Money's run: {
  "after": [
    "Money\n\nYou’re square with everyone.\n\nWho pays whom\n\nNobody owes anybody.\n\nWhat people paid for\nYou paid $42.00 for the gas bill, split between ada.\n\nWhen someone adds what they paid, it is split between them and whoever says they were in on it. Everyone in your group — ada, bo — sees it.\n\nAdd what you paid\n\nWhat it was for:  How much:  Add it, paid by you"
  ],
  "logs": [
    "error: Failed to load resource: the server responded with a status of 404 (Not Found)"
  ],
  "said": "Money\n\nYou’re square with everyone.\n\nWho pays whom\n\nNobody owes anybody.\n\nWhat people paid for\nYou paid $42.00 for the gas bill, split between ada.\n\nWhen someone adds what they paid, it is split between them and whoever says they were in on it. Everyone in your group — ada, bo — sees it.\n\nAdd what you paid\n\nWhat it was for:  How much:  Add it, paid by you",
  "title": "Money"
}
