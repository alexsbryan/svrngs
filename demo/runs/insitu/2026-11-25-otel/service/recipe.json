{
  "service": "notes-to-forms",
  "version": "0.3.0",
  "says": "Acme Notes-to-Forms",
  "params": {
    "port": { "type": "port", "default": 8610, "choices": [8610, 8611, 8612] },
    "gateway_port": { "type": "port", "default": 8640, "choices": [8640, 8641] },
    "data": { "type": "dir", "default": "/srv/notes-to-forms" },
    "inbox": { "type": "dir", "default": "/srv/notes-to-forms/inbox" },
    "clearinghouse": { "type": "url", "default": "http://clearinghouse:8700" }
  },
  "needs": [
    { "probe": "systemd", "says": "systemd keeps services running" },
    { "probe": "memory", "min_gb": 2, "says": "at least 2 GB of memory" },
    { "probe": "disk_free", "at": "{data}", "min_gb": 1, "says": "at least 1 GB free where the service keeps its data" },
    { "probe": "port_free", "port": "{port}", "says": "its port is free" },
    { "probe": "disk_encrypted", "at": "{data}", "severity": "warn", "says": "the disk under its data is encrypted" }
  ],
  "artifacts": [],
  "effects": { "clearinghouse": { "upstream": "{clearinghouse}", "says": "claims sent to the clinic's clearinghouse" } },
  "telemetry": {
    "attributes": { "input.ref": "hash", "outcome": ["submitted", "rejected", "error", "held", "unjudged"] },
    "spans": ["note", "parse", "lookup", "submit"]
  },
  "steps": [
    { "do": "user", "name": "notes", "says": "Make an account for the service, which can't sign in" },
    { "do": "dir", "path": "{data}/state", "mode": "0700", "owner": "notes", "says": "Make the folder it keeps its records in, readable only by it" },
    { "do": "unpack", "artifact": "service.tar.gz", "to": "{data}/app", "says": "Unpack the service, checked against the vendor's signature" },
    { "do": "telemetry", "says": "Keep its telemetry on this machine, in the site's own collector" },
    { "do": "gateway", "says": "Send its claims through the site's gateway, which records each one" },
    { "do": "unit", "name": "notes-to-forms", "user": "notes",
      "env": { "OTEL_EXPORTER_OTLP_ENDPOINT": "{otlp}", "CLEARINGHOUSE_URL": "{effect.clearinghouse}" },
      "exec": ["/usr/bin/python3", "{data}/app/server.py", "--port", "{port}", "--state", "{data}/state", "--inbox", "{inbox}"],
      "writes": ["{data}/state"], "says": "Run it as that account, reading the inbox, kept running by systemd" },
    { "do": "health", "url": "http://127.0.0.1:{port}/health", "expect": { "service": "notes-to-forms", "version": "{version}" }, "within_s": 15, "says": "Check it answers on its port" }
  ],
  "trial": { "exec": ["/usr/bin/python3", "{app}/server.py", "--replay", "{inputs}", "--state", "{state}", "--out", "{out}"], "inputs": "{inbox}", "state": ["{data}/state/clients.db"], "result": "result.json" }
}
