--- /dev/null
+++ b/tests/test_observe.py
@@ -0,0 +1,46 @@
+import json, os, sqlite3, sys, tempfile, unittest
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), ".."))
+import clients, notes, observe
+
+ROOT = os.path.join(os.path.dirname(__file__), "..")
+CONTRACT = json.load(open(os.path.join(ROOT, "recipe.json")))["telemetry"]["attributes"]
+
+
+class Observe(unittest.TestCase):
+    def test_every_emitted_value_is_declared_in_the_contract(self):
+        claim = {"date": "2026-11-03", "client_id": "TEST-0001", "cpt": "90834", "icd10": "F41.1",
+                 "minutes": "50", "payer": "SYNTH", "plan": "P1"}
+        attrs = {**observe.claim_forms(claim), **observe.reject_echoes('{"field":"plan"}', claim),
+                 "reject.field": observe.reject_field('{"field":"plan"}'), "reject.body": observe.reject_body("x")}
+        for k, v in attrs.items():
+            with self.subTest(k):
+                self.assertIn(v, CONTRACT[k])
+
+    def test_date_forms(self):
+        for s, want in [("2026-11-03", "iso"), ("11/03/2026", "slash_mdy"), ("2026-11-03 10:00", "iso_then_text"),
+                        ("Nov 3, 2026", "has_letters"), ("", "empty"), ("2026–11–03", "non_ascii")]:
+            self.assertEqual(observe.date_form(s), want)
+            self.assertIn(want, CONTRACT["parse.date_form"])
+
+    def test_a_bad_date_raises_the_same_error_with_its_form(self):
+        raw = b"Date of service: 11/03/2026\nClient ID: TEST-0001\nCPT: 90834\nDiagnosis: F41.1\nMinutes: 50\n"
+        with self.assertRaises(ValueError) as c:
+            notes.parse(raw)
+        self.assertEqual((c.exception.date_form, c.exception.error_form), ("slash_mdy", "does_not_match"))
+
+    def test_describe_names_a_null_plan(self):
+        with tempfile.TemporaryDirectory() as d:
+            db = os.path.join(d, "clients.db")
+            c = sqlite3.connect(db)
+            c.execute("create table clients (client_id text, payer text, plan_id text)")
+            c.execute("insert into clients values ('TEST-0002', 'SYNTH', null)")
+            c.commit()
+            got = clients.describe(db, "TEST-0002")
+            self.assertEqual(got["lookup.plan_id.kind"], "none")
+            self.assertEqual(clients.describe(db, "TEST-9999"), {"lookup.row": "missing"})
+            for k, v in got.items():
+                self.assertIn(v, CONTRACT[k])
+
+
+if __name__ == "__main__":
+    unittest.main()
