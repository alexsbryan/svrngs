+}
+
+
+def date_guesses(s) -> dict:
+    """For each candidate format, whether the date parses under it."""
+    out = {}
+    for name, fmt in DATE_GUESSES.items():
+        try:
+            datetime.strptime(s.strip(), fmt)
+            ok = True
+        except Exception:
+            ok = False
+        out[f"date.parses_as.{name}"] = "yes" if ok else "no"
+    try:
+        out["date.has.ordinal_suffix"] = "yes" if re.search(r"\d(st|nd|rd|th)\b", s, re.I) else "no"
+        out["date.has.comma"] = "yes" if "," in s else "no"
+        out["date.has.slash"] = "yes" if "/" in s else "no"
+        out["date.has.dash"] = "yes" if "-" in s else "no"
+        out["date.has.dot"] = "yes" if "." in s else "no"
+        out["date.has.four_digit_year"] = "yes" if re.search(r"\b\d{4}\b", s) else "no"
+        out["date.has.time"] = "yes" if re.search(r"\d:\d\d", s) else "no"
+        out["date.starts_with.letter"] = "yes" if s[:1].isalpha() else "no"
+        out["date.starts_with.digit"] = "yes" if s[:1].isdigit() else "no"
+    except Exception:
