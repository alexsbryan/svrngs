+
+DATE_GUESSES = {
+    "full_month_d_comma_y": "%B %d, %Y", "abbr_month_d_comma_y": "%b %d, %Y",
+    "full_month_d_y": "%B %d %Y", "abbr_month_d_y": "%b %d %Y",
