+
+
+def minutes_guesses(v) -> dict:
+    out = {}
+    for name, pat in MINUTES_GUESSES.items():
+        try:
+            ok = isinstance(v, str) and re.fullmatch(pat, v, re.I) is not None
+        except Exception:
+            ok = False
+        out[f"minutes.is.{name}"] = "yes" if ok else "no"
+    if isinstance(v, str):
+        out["minutes.has.digit"] = "yes" if re.search(r"\d", v) else "no"
+        out["minutes.has.letter"] = "yes" if re.search(r"[A-Za-z]", v) else "no"
+        out["minutes.has.space"] = "yes" if " " in v else "no"
+        out["minutes.starts_with.digit"] = "yes" if v[:1].isdigit() else "no"
+    return out
+
+
+KNOWN_KEYS = ["code", "detail", "error", "errors", "field", "message", "reason", "status", "claim", "id"]
+
+
+def _strings(doc):
+    if isinstance(doc, str):
+        yield doc
+    elif isinstance(doc, dict):
+        for v in doc.values():
+            yield from _strings(v)
+    elif isinstance(doc, list):
+        for v in doc:
+            yield from _strings(v)
+
+
+def reject_says(body, claim: dict) -> dict:
+    """Which claim field names the rejection's own words mention, apart
+    from any copy of the claim it echoes; and which top-level keys it has."""
+    out = {}
+    try:
+        doc = json.loads(body)
+    except Exception:
+        return {"reject.says.parsed": "no"}
+    out["reject.says.parsed"] = "yes"
+    echoed = {v for v in claim.values() if isinstance(v, str)}
+    words = " ".join(s for s in _strings(doc) if s not in echoed)
+    for f in CLAIM_FIELDS:
+        out[f"reject.says.{f}"] = "yes" if re.search(rf"\b{re.escape(f)}\b", words, re.I) else "no"
+    if isinstance(doc, dict):
+        for k in KNOWN_KEYS:
+            out[f"reject.key.{k}"] = "yes" if k in doc else "no"
+    return out
