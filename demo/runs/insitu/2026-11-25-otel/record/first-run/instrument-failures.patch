+"""Closed-set descriptions of values the service handles, for telemetry.
+
+Each function maps a value to one member of a set declared in recipe.json
+(telemetry.attributes), so the site can pass it as written: the member names a
+form, never the value. Every function returns a member for every input; none
+raises, so observing can't change an outcome.
+"""
+import json, re
+
+DATE_FORMS = ["iso", "iso_unpadded", "iso_then_text", "slash_mdy", "slash_mdy_short", "slash_ymd",
+              "dot_dmy", "dash_mdy", "has_letters", "non_ascii", "empty", "other"]
+_DATE = [
+    ("iso", r"\d{4}-\d{2}-\d{2}"), ("iso_unpadded", r"\d{4}-\d{1,2}-\d{1,2}"),
+    ("iso_then_text", r"\d{4}-\d{2}-\d{2}\D.*"), ("slash_mdy", r"\d{1,2}/\d{1,2}/\d{4}"),
+    ("slash_mdy_short", r"\d{1,2}/\d{1,2}/\d{2}"), ("slash_ymd", r"\d{4}/\d{1,2}/\d{1,2}"),
+    ("dot_dmy", r"\d{1,2}\.\d{1,2}\.\d{4}"), ("dash_mdy", r"\d{1,2}-\d{1,2}-\d{4}"),
+]
+
+
+def date_form(s) -> str:
+    try:
+        if s == "":
+            return "empty"
+        if not s.isascii():
+            return "non_ascii"
+        for form, pat in _DATE:
+            if re.fullmatch(pat, s, re.S):
+                return form
+        return "has_letters" if re.search(r"[A-Za-z]", s) else "other"
+    except Exception:
+        return "other"
+
+
+ERROR_FORMS = ["does_not_match", "unconverted_remains", "out_of_range", "other"]
+
+
+def date_error_form(e) -> str:
+    m = str(e)
+    if m.startswith("time data"):
+        return "does_not_match"
+    if m.startswith("unconverted data remains"):
+        return "unconverted_remains"
+    if "out of range" in m or "must be in" in m:
+        return "out_of_range"
+    return "other"
+
+
+KINDS = ["str", "empty", "blank", "none", "int", "other"]
+
+
+def kind(v) -> str:
+    if v is None:
+        return "none"
+    if isinstance(v, bool):
+        return "other"
+    if isinstance(v, int):
+        return "int"
+    if isinstance(v, str):
+        return "empty" if v == "" else "blank" if not v.strip() else "str"
+    return "other"
+
+
+CASES = ["upper", "lower", "mixed", "uncased", "not_str"]
+
+
+def case(v) -> str:
+    if not isinstance(v, str):
+        return "not_str"
+    if v.upper() == v.lower():
+        return "uncased"
+    return "upper" if v == v.upper() else "lower" if v == v.lower() else "mixed"
+
+
+TEXT_FORMS = ["alnum", "alnum_punct", "has_space", "non_ascii", "empty", "not_str"]
+
+
+def text_form(v) -> str:
+    if not isinstance(v, str):
+        return "not_str"
+    if v == "":
+        return "empty"
+    if not v.isascii():
+        return "non_ascii"
+    if any(c.isspace() for c in v):
+        return "has_space"
+    return "alnum" if v.isalnum() else "alnum_punct"
+
+
+ICD_FORMS = ["canonical", "lowercase", "no_dot", "has_space", "non_ascii", "other"]
+
+
+def icd_form(v) -> str:
+    if not isinstance(v, str):
+        return "other"
+    if not v.isascii():
+        return "non_ascii"
+    if re.fullmatch(r"[A-Z]\d[0-9A-Z](\.[0-9A-Z]{1,4})?", v):
+        return "canonical"
+    if re.fullmatch(r"[A-Za-z]\d[0-9A-Za-z](\.[0-9A-Za-z]{1,4})?", v):
+        return "lowercase"
+    if re.fullmatch(r"[A-Z]\d[0-9A-Z]{2,5}", v):
+        return "no_dot"
+    if any(c.isspace() for c in v):
+        return "has_space"
+    return "other"
+
+
+DIGIT_FORMS = ["digits", "non_digits", "empty", "not_str"]
+
+
+def digit_form(v) -> str:
+    if not isinstance(v, str):
+        return "not_str"
+    if v == "":
+        return "empty"
+    return "digits" if v.isascii() and v.isdigit() else "non_digits"
+
+
+CLAIM_FIELDS = ["date", "client_id", "cpt", "icd10", "minutes", "payer", "plan"]
+REJECT_FIELDS = CLAIM_FIELDS + ["none", "several", "unreadable"]
+
+
+def claim_forms(claim: dict) -> dict:
+    """The form of each claim field, keyed by attribute name."""
+    return {
+        "claim.date.form": date_form(claim.get("date")) if isinstance(claim.get("date"), str) else "other",
+        "claim.client_id.form": text_form(claim.get("client_id")),
+        "claim.cpt.form": digit_form(claim.get("cpt")),
+        "claim.icd10.form": icd_form(claim.get("icd10")),
+        "claim.minutes.form": digit_form(claim.get("minutes")),
+        "claim.payer.form": text_form(claim.get("payer")),
+        "claim.plan.form": text_form(claim.get("plan")),
+    }
+
+
+def reject_field(body) -> str:
+    """Which claim field a rejection names: a JSON 'field' member if there is
+    one, else the claim field names that appear as words in the body."""
+    try:
+        doc = json.loads(body)
+    except Exception:
+        doc = None
+    if isinstance(doc, dict):
+        for k in ("field", "fields", "loc", "path"):
+            v = doc.get(k)
+            if isinstance(v, str) and v in CLAIM_FIELDS:
+                return v
+    try:
+        hits = [f for f in CLAIM_FIELDS if re.search(rf"\b{re.escape(f)}\b", body)]
+    except Exception:
+        return "unreadable"
+    return "none" if not hits else hits[0] if len(hits) == 1 else "several"
+
+
+REJECT_BODY = ["json_object", "json_other", "text", "empty"]
+
+
+def reject_body(body) -> str:
+    if not body:
+        return "empty"
+    try:
+        doc = json.loads(body)
+    except Exception:
+        return "text"
+    return "json_object" if isinstance(doc, dict) else "json_other"
+
+
+def reject_echoes(body, claim: dict) -> dict:
+    """For each claim field, whether the rejection quotes its value back.
+    Names and yes/no only; the value never leaves this function."""
+    out = {}
+    for f in CLAIM_FIELDS:
+        v = claim.get(f)
+        try:
+            out[f"reject.echoes.{f}"] = "yes" if isinstance(v, str) and v and v in body else "no"
+        except Exception:
+            out[f"reject.echoes.{f}"] = "no"
+    return out
