+
+
+# Round 3. Round 2 found the failing dates start with a letter and carry a
+# comma, a dash and a four-digit year, and parse under none of DATE_GUESSES.
+
+WEEKDAYS = ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"]
+MONTHS = ["january", "february", "march", "april", "may", "june", "july", "august", "september",
+          "october", "november", "december"]
+
+
+def _parses(s, fmt):
+    try:
+        datetime.strptime(s.strip(), fmt)
+        return True
+    except Exception:
+        return False
+
+
+ISO_GUESSES = {"iso": "%Y-%m-%d", **DATE_GUESSES}
+
+
+def date_probe(s) -> dict:
+    out = {}
+    try:
+        low = s.lower()
+        words = re.findall(r"[a-z]+", low)
+        out["date.word.weekday_full"] = "yes" if any(w in WEEKDAYS for w in words) else "no"
+        out["date.word.weekday_abbr"] = "yes" if any(w in [d[:3] for d in WEEKDAYS] for w in words) else "no"
+        out["date.word.month_full"] = "yes" if any(w in MONTHS for w in words) else "no"
+        out["date.word.month_abbr"] = "yes" if any(w in [m[:3] for m in MONTHS] for w in words) else "no"
+        out["date.word.other"] = "yes" if any(w not in WEEKDAYS + MONTHS + [d[:3] for d in WEEKDAYS] + [m[:3] for m in MONTHS] for w in words) else "no"
+        out["date.contains.iso"] = "yes" if re.search(r"\d{4}-\d{2}-\d{2}", s) else "no"
+        out["date.years.two"] = "yes" if len(re.findall(r"\d{4}", s)) >= 2 else "no"
+        out["date.has.spaced_dash"] = "yes" if " - " in s else "no"
+        out["date.commas.two"] = "yes" if s.count(",") >= 2 else "no"
+        for n in (12, 16, 20, 25, 30, 35, 40):
+            out[f"date.len.over_{n}"] = "yes" if len(s) > n else "no"
+        head, _, rest = s.partition(",")
+        out["date.head.is_weekday"] = "yes" if head.strip().lower() in WEEKDAYS + [d[:3] for d in WEEKDAYS] else "no"
+        for name, fmt in ISO_GUESSES.items():
+            out[f"date.rest.parses_as.{name}"] = "yes" if _parses(rest, fmt) else "no"
+        m = re.search(r"\d{4}-\d{2}-\d{2}", s)
+        out["date.iso_inside.valid"] = "yes" if m and _parses(m.group(0), "%Y-%m-%d") else "no"
+    except Exception:
+        pass
+    return out
