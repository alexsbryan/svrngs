+++ b/notes.py
@@ -1,4 +1,5 @@
 """Session note -> claim fields. A stand-in for the vendor's parser."""
+import re
 from datetime import datetime
 
 FIELDS = {"Date of service": "date", "Client ID": "client_id", "CPT": "cpt", "Diagnosis": "icd10", "Minutes": "minutes"}
@@ -20,5 +21,15 @@ def parse(raw: bytes) -> dict:
     missing = [k for k in FIELDS.values() if k not in form]
     if missing:
         raise KeyError(f"missing {missing}")
+    form["minutes"] = minutes(form["minutes"])
     form["date"] = datetime.strptime(form["date"], "%Y-%m-%d").date().isoformat()
     return form
+
+
+def minutes(value: str) -> str:
+    """Minutes as the clearinghouse takes them: digits only. Some notes write
+    the unit ("50 min"), which the clearinghouse rejects with 422; the unit is
+    dropped. Any other form is passed on as written, as before, for the
+    clearinghouse to judge."""
+    m = re.fullmatch(r"(\d+)\s*(?:min|mins|minutes)", value, re.I)
+    return m.group(1) if m else value
