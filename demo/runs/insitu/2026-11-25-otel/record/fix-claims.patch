new file mode 100644
index 0000000..63740b9
--- /dev/null
+++ b/fixtures/date-written-with-remark.txt
@@ -0,0 +1,7 @@
+Session note (synthetic, no real person)
+Date of service: Nov 5, 2026 - synthetic remark, for the test
+Client ID: TEST-0003
+CPT: 90834
+Diagnosis: F41.1
+Minutes: 45
+Client reviewed a synthetic plan.
diff --git a/notes.py b/notes.py
index 2c4c739..460bd17 100644
--- a/notes.py
+++ b/notes.py
@@ -22,10 +22,29 @@ def parse(raw: bytes) -> dict:
     if missing:
         raise KeyError(f"missing {missing}")
     form["minutes"] = minutes(form["minutes"])
-    form["date"] = datetime.strptime(form["date"], "%Y-%m-%d").date().isoformat()
+    form["date"] = service_date(form["date"])
     return form
 
 
+# Some notes write the date as "Nov 3, 2026 - <a remark>" rather than ISO.
+# Only these written forms are read; the remark after " - " is not part of
+# the date. Anything else still raises, as before.
+WRITTEN = ("%b %d, %Y", "%B %d, %Y")
+
+
+def service_date(value: str) -> str:
+    try:
+        return datetime.strptime(value, "%Y-%m-%d").date().isoformat()
+    except ValueError:
+        head = value.split(" - ", 1)[0].strip()
+        for fmt in WRITTEN:
+            try:
+                return datetime.strptime(head, fmt).date().isoformat()
+            except ValueError:
+                pass
+        raise
+
+
 def minutes(value: str) -> str:
     """Minutes as the clearinghouse takes them: digits only. Some notes write
     the unit ("50 min"), which the clearinghouse rejects with 422; the unit is
