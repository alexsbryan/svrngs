From 9908cad0a4481eeffb33694309e230fee67348e4 Mon Sep 17 00:00:00 2001
From: Alex <alexsbryan@gmail.com>
Date: Wed, 25 Nov 2026 12:39:46 -0800
Subject: [PATCH 1/3] fix: hold a note whose client has no plan, instead of
 crashing

Production telemetry: 2 of 30 notes (input.ref f6e9bf0aff7b, fd47233a0618)
end in AttributeError at clients.py:10 plan_of (plan_id.upper()). Their
error log bodies are 93 and 98 long = 'note ' + file name (37, 42) + ' failed: '
+ 42, the length of "'NoneType' object has no attribute 'upper'"; the
instrumentation trial (instrument-failures@26ec1f2) confirmed
lookup.plan_id.kind = none (len 4) for exactly those two.

Acme can't know the plan, so the note is now held (outcome 'held', declared
in the contract) with held.reason=plan_missing, and the log names the input
ref, not the client id.

Test: tests/test_clients.py fails on main (AttributeError, 2 errors) and
passes here.
---
 clients.py            |  9 +++++++++
 recipe.json           |  4 ++--
 server.py             |  7 ++++++-
 tests/test_clients.py | 34 ++++++++++++++++++++++++++++++++++
 4 files changed, 51 insertions(+), 3 deletions(-)
 create mode 100644 tests/test_clients.py

diff --git a/clients.py b/clients.py
index b917e2a..dc9f612 100644
--- a/clients.py
+++ b/clients.py
@@ -2,9 +2,18 @@
 import sqlite3
 
 
+class MissingPlan(LookupError):
+    """The client exists but its record has no plan to bill."""
+
+
 def plan_of(db: str, client_id: str) -> dict:
     row = sqlite3.connect(db).execute("select payer, plan_id from clients where client_id = ?", (client_id,)).fetchone()
     if row is None:
         raise LookupError("no such client")
     payer, plan_id = row
+    if not isinstance(plan_id, str) or not plan_id.strip():
+        # Some rows came over from the old system with no plan (NULL). A claim
+        # with no plan can't be filed and Acme can't guess one, so the note is
+        # held for the clinic to complete the record, not crashed on.
+        raise MissingPlan("client has no plan on record")
     return {"payer": payer, "plan": plan_id.upper()}
