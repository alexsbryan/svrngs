# The clinic's server, connected this time (outbound only, nothing published):
# Fedora 45 with systemd, Node for the site tool, the OpenTelemetry SDK the
# vendor's service exports with, the OpenTelemetry Collector the site agent
# receives with, and svrngs for the vendor's view. Pins: otelcol-contrib
# 0.165.0 (sha256 bd6e73d9…aa33), opentelemetry-sdk and -exporter-otlp-proto-http
# 1.39.1, svrngs from this checkout.
FROM registry.fedoraproject.org/fedora-toolbox:45
RUN dnf -y install systemd nodejs procps-ng iproute sqlite python3-pip && dnf clean all \
 && pip install --no-cache-dir opentelemetry-sdk==1.39.1 opentelemetry-exporter-otlp-proto-http==1.39.1 \
 && useradd -m admin && systemctl set-default multi-user.target
COPY vendor-cache/otelcol-contrib_0.165.0_linux_amd64.tar.gz /tmp/otelcol.tgz
RUN echo "bd6e73d94bf3359ad6fac25529a8ee308adb9b0b8a0e8af034ed3891fbe5aa33  /tmp/otelcol.tgz" | sha256sum -c \
 && tar -xzf /tmp/otelcol.tgz -C /usr/local/bin otelcol-contrib && rm /tmp/otelcol.tgz
COPY vendor-cache/svrngs /usr/local/bin/svrngs
CMD ["/usr/lib/systemd/systemd"]
