{
  // The service workers, web/sw.js and web/lend.js, checked as jsconfig.json
  // checks the pages, in the global they run in: a worker's, whose lib
  // declares `FetchEvent`, `Clients` and `ServiceWorkerGlobalScope` and no
  // `document`. scripts/types.mjs reads it after jsconfig.json, and reports
  // the errors in these files alone; a module they import is the pages'.
  "extends": "./jsconfig.json",
  "compilerOptions": {
    "lib": ["es2024", "webworker"]
  },
  "exclude": [],
  "include": ["web/sw.js", "web/lend.js", "crates/svrngs-node/src/home/ui/globals.d.ts"]
}
