{
  "_comment": "Permission contract for a ralph worker in svrngs, run as `claude -p` by commonwealth-ai's scripts/ralph-claude-shim.sh. The deny list is commonwealth-ai ralph/claude-settings.json's: never push, never --no-verify, never rewrite history, never stage everything, never delegate. The allow list is svrngs' own checks and tools.",
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Read", "Edit", "Write", "MultiEdit", "Glob", "Grep", "TodoWrite",
      "Bash(git status*)", "Bash(git diff*)", "Bash(git log*)", "Bash(git show*)",
      "Bash(git grep*)", "Bash(git rev-parse*)", "Bash(git ls-files*)",
      "Bash(git add *)", "Bash(git commit *)", "Bash(git checkout -- *)", "Bash(git restore *)",
      "Bash(scripts/check.sh*)", "Bash(./scripts/check.sh*)",
      "Bash(scripts/ralph-mark.sh *)", "Bash(./scripts/ralph-mark.sh *)",
      "Bash(python3 scripts/*)", "Bash(python3 -c *)",
      "Bash(cargo build*)", "Bash(cargo check*)", "Bash(cargo test*)", "Bash(cargo fmt*)",
      "Bash(cargo clippy*)", "Bash(cargo add *)", "Bash(cargo tree*)", "Bash(cargo metadata*)",
      "Bash(node *)", "Bash(npm *)", "Bash(npx *)",
      "Bash(ls *)", "Bash(cat *)", "Bash(head *)", "Bash(tail *)", "Bash(wc *)", "Bash(grep *)",
      "Bash(rg *)", "Bash(sed *)", "Bash(awk *)", "Bash(sort *)", "Bash(uniq *)", "Bash(diff *)",
      "Bash(find *)", "Bash(echo *)", "Bash(printf *)", "Bash(test *)", "Bash(which *)",
      "Bash(jq *)", "Bash(mkdir -p *)", "Bash(cd *)", "Bash(date*)", "Bash(true)"
    ],
    "deny": [
      "Agent", "WebFetch", "WebSearch",
      "Bash(git push*)", "Bash(git reset --hard*)", "Bash(git rebase*)", "Bash(git commit --amend*)",
      "Bash(git filter-*)", "Bash(* --no-verify*)", "Bash(sudo *)", "Bash(rm -rf /*)", "Bash(rm -rf ~*)",
      "Bash(git add -A*)", "Bash(git add --all*)", "Bash(git add -u*)", "Bash(git add .)",
      "Bash(git add . *)", "Bash(git add :/*)", "Bash(git commit -a*)", "Bash(git commit --all*)"
    ]
  }
}
