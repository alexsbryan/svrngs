+}
+
+/// `POST /join`, and `/v1/join` for `svrngs join` ([`asked`]): another
+/// group joined by its link ([`crate::node::Host::join`]), its folder
+/// placed: its name, seed, who joined — none when in already — and where
+/// its folder is or why not; or why not, in the page's words and as itself.
+async fn join(State(at): State<Asking>, Json(j): Json<Joining>) -> Response {
+    let (link, person) = (Link::parse(&j.link), crate::group::Name::parse(&j.person));
+    let (Some(link), Ok(person)) = (link, person) else {
+        tracing::debug!(target: "home", "home: refused — no whole link, or no name to join as");
+        let why = "Paste the whole link, to the end, and the name you go by in the group.";
+        return LendRefusal::Closed.say(StatusCode::BAD_REQUEST, why);
+    };
+    let entered = at.host.join(&link, &person).await;
+    tracing::debug!(target: "home", ?entered, "home: a group joined by its link, or why not");
+    match entered {
+        Ok(entered) => {
+            let (dir, placed) = at.folders.place(entered.seed());
+            let person = match &entered {
+                crate::join::Entered::In { person, .. } => Some(person.as_str()),
+                crate::join::Entered::AlreadyIn(_) => None,
+            };
+            let seed = entered.seed();
+            Json(serde_json::json!({
+                "name": seed.name().as_str(), "seed": seed.to_text(), "person": person,
+                "dir": dir, "unplaced": placed.err(),
+            }))
+            .into_response()
+        }
+        Err(e) => {
+            let body = serde_json::json!({ "error": e.to_string(), "refused": e });
+            (StatusCode::CONFLICT, Json(body)).into_response()
+        }
+    }
+}
