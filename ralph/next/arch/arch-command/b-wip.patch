+    let seed = seed.unwrap_or_else(|| panic!("{name} is held"));
+    let dir = svrngs_node::group_dir_in(&data, &seed.id()).unwrap();
+    group::read_relay(&dir).unwrap().map(|r| r.to_string())
+}
