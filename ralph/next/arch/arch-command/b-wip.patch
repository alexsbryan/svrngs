+/// `svrngs <args>`, this build's, with `home` its `HOME` and nothing else
+/// of this computer's environment but its `PATH`.
+fn svrngs(home: &Path, args: &[&str]) -> tokio::process::Command {
+    let mut c = tokio::process::Command::new(env!("CARGO_BIN_EXE_svrngs"));
+    c.args(args)
+        .env_clear()
+        .env("HOME", home)
+        .env("PATH", std::env::var_os("PATH").unwrap_or_default())
+        .env("RUST_LOG", "cli=debug,group=debug")
+        .env("NO_COLOR", "1")
+        .stdout(std::process::Stdio::piped())
+        .stderr(std::process::Stdio::piped())
+        .kill_on_drop(true);
+    c
+}
+
+/// What `svrngs <args>` printed: all of it when it stops by itself, or up
+/// to "Leave this running" when it starts svrngs, which is then stopped,
+/// as a terminal's Ctrl-C stops it. Whether it started svrngs, and its
+/// traces.
+async fn said(home: &Path, args: &[&str]) -> (String, bool, String) {
+    let mut child = svrngs(home, args).spawn().unwrap();
+    let mut out = tokio::io::BufReader::new(child.stdout.take().unwrap()).lines();
+    let (said, started) = tokio::time::timeout(Duration::from_secs(60), async {
+        let mut said = String::new();
+        while let Ok(Some(line)) = out.next_line().await {
+            if line.starts_with("Leave this running") {
+                return (said, true);
+            }
+            said += &line;
+            said += "\n";
+        }
+        (said, false)
+    })
+    .await
+    .unwrap_or_else(|_| panic!("svrngs {args:?} said all it says within 60 s"));
+    let _ = child.start_kill();
+    let output = child.wait_with_output().await.unwrap();
+    let traced = String::from_utf8_lossy(&output.stderr).into_owned();
+    (said, started, traced)
+}
