+pub(crate) fn asked(at: Asking) -> Router {
+    use axum::routing::post;
+    Router::new()
+        .route("/v1/group", post(found))
+        .route("/v1/link", post(link))
+        .route("/v1/join", post(join))
+        .with_state(at)
+}
